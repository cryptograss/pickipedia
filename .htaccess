# PHP limits (upload_max_filesize, post_max_size, memory_limit) are baked into the
# wiki container image, not set here. See the docker-wiki role in cryptograss/maybelle-config.

# Block aggressive bots eating bandwidth (Apache 2.4 syntax)
SetEnvIfNoCase User-Agent "meta-externalagent" bad_bot
SetEnvIfNoCase User-Agent "Amazonbot" bad_bot

<RequireAll>
    Require all granted
    Require not env bad_bot
</RequireAll>

# Allow iframe embedding (for Rabbithole integration)
Header unset X-Frame-Options
Header always unset X-Frame-Options

RewriteEngine On

# Short URL rewrite for MediaWiki
# Maps /wiki/Page_Name to index.php?title=Page_Name
RewriteBase /

# Build and maintenance scripts. They are deployed into this tree because this
# tree is what reaches the VPS, and the podcast firehose runs from a cron
# there. Apache would otherwise serve them as plain text — harmless, since it
# is all public on GitHub, but a wiki has no business serving its own scripts.
RewriteRule ^tools/ - [F,L]

# Short URL for wiki pages
RewriteRule ^wiki/(.*)$ index.php?title=$1 [QSA,L]

# Redirect bare /wiki to Main_Page
RewriteRule ^wiki$ index.php?title=Main_Page [QSA,L]

# The bacon graph's page is /bacon (Justin, #connectome, 16 Nov 2026). Its files stay in assets/connectome/,
# where the build writes them, and the page asks for them there. [END]: no rule here sees the rewrite again.
RewriteRule ^bacon/?$ assets/connectome/index.html [END]

# Its old address still works, and says where the page lives now, with the query (?p=, ?walk=, ?host=).
# THE_REQUEST is the request line as the reader sent it, so only a reader's own request is sent on. Caddy ends
# TLS in front of this Apache, and a redirect Apache makes alone says http:// (as /assets/connectome without
# its slash does): a frame on an https page that is sent to http:// is blocked, and Rabbithole frames this
# page. So the redirect says the scheme Caddy passes on in X-Forwarded-Proto.
RewriteCond %{THE_REQUEST} ^\S+\s/assets/connectome(/|/index\.html)?(\?\S*)?\s
RewriteCond %{HTTP:X-Forwarded-Proto} =https
RewriteRule ^assets/connectome(/|/index\.html)?$ https://%{HTTP_HOST}/bacon [R=301,L]
RewriteCond %{THE_REQUEST} ^\S+\s/assets/connectome(/|/index\.html)?(\?\S*)?\s
RewriteRule ^assets/connectome(/|/index\.html)?$ /bacon [R=301,L]

# PHP limits (upload_max_filesize, post_max_size, memory_limit) are baked into the
# wiki container image, not set here. See the docker-wiki role in cryptograss/maybelle-config.

# Block aggressive bots eating bandwidth (Apache 2.4 syntax)
SetEnvIfNoCase User-Agent "meta-externalagent" bad_bot
SetEnvIfNoCase User-Agent "Amazonbot" bad_bot

<RequireAll>
    Require all granted
    Require not env bad_bot
</RequireAll>

# Allow iframe embedding (for Rabbithole integration)
Header unset X-Frame-Options
Header always unset X-Frame-Options

RewriteEngine On

# Short URL rewrite for MediaWiki
# Maps /wiki/Page_Name to index.php?title=Page_Name
RewriteBase /

# Build and maintenance scripts. They are deployed into this tree because this
# tree is what reaches the VPS, and the podcast firehose runs from a cron
# there. Apache would otherwise serve them as plain text — harmless, since it
# is all public on GitHub, but a wiki has no business serving its own scripts.
RewriteRule ^tools/ - [F,L]

# Short URL for wiki pages
RewriteRule ^wiki/(.*)$ index.php?title=$1 [QSA,L]

# Redirect bare /wiki to Main_Page
RewriteRule ^wiki$ index.php?title=Main_Page [QSA,L]

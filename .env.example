# MediaWiki version for the local/preview stack. The production build version
# is set in the Jenkinsfile, which is authoritative; keep this matching it.
MEDIAWIKI_VERSION=1.43.6

# Database configuration
DB_TYPE=mysql
DB_SERVER=localhost
DB_NAME=pickipedia
DB_USER=pickipedia
DB_PASSWORD=changeme

# Wiki configuration
WIKI_NAME=PickiPedia
WIKI_URL=https://pickipedia.xyz
SECRET_KEY=generate-a-long-random-string
UPGRADE_KEY=generate-another-random-string


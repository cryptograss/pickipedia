{
	"name": "PickiPediaContent",
	"version": "0.1.0",
	"author": [
		"Magent",
		"Justin Holmes"
	],
	"url": "https://github.com/cryptograss/pickipedia",
	"descriptionmsg": "pickipediacontent-desc",
	"license-name": "GPL-2.0-or-later",
	"type": "other",
	"requires": {
		"MediaWiki": ">= 1.43.0"
	},
	"AutoloadNamespaces": {
		"MediaWiki\\Extension\\PickiPediaContent\\": "src/"
	},
	"HookHandlers": {
		"main": {
			"class": "MediaWiki\\Extension\\PickiPediaContent\\Hooks"
		}
	},
	"Hooks": {
		"BeforePageDisplay": "main",
		"ChangesListSpecialPageStructuredFilters": "main",
		"GetDoubleUnderscoreIDs": "main",
		"GetPreferences": "main",
		"getUserPermissionsErrors": "main",
		"LinksUpdateComplete": "main",
		"PageDeleteComplete": "main",
		"PageMoveComplete": "main",
		"PageSaveComplete": "main",
		"ParserFirstCallInit": "main",
		"RequestContextCreateSkin": "main",
		"SaveUserOptions": "main",
		"ScribuntoExternalLibraryPaths": "main",
		"SkinAfterContent": "main",
		"UploadComplete": "main"
	},
	"MessagesDirs": {
		"PickiPediaContent": [
			"i18n"
		]
	},
	"ResourceModules": {
		"ext.pickipediaContent.styles": {
			"styles": [
				"ext.pickipediaContent.css",
				"ext.pickipediaContent.templates.css"
			]
		},
		"ext.pickipediaContent.tidingBanner": {
			"scripts": [
				"ext.pickipediaContent.tidingBanner.js"
			],
			"styles": [
				"ext.pickipediaContent.tidingBanner.css"
			],
			"dependencies": [
				"mediawiki.util"
			]
		},
		"ext.pickipediaContent.connectome.styles": {
			"styles": [
				"ext.pickipediaContent.connectome.css"
			]
		},
		"ext.pickipediaContent.connectome": {
			"scripts": [
				"ext.pickipediaContent.connectome.js"
			]
		},
		"ext.pickipediaContent.chartifactButton": {
			"scripts": [
				"ext.pickipediaContent.chartifactButton.js"
			],
			"messages": [
				"pickipediacontent-chartifact-button",
				"pickipediacontent-chartifact-add-title"
			],
			"dependencies": [
				"jquery.textSelection",
				"mediawiki.util"
			],
			"styles": [
				"ext.pickipediaContent.chartifactButton.css"
			]
		},
		"skins.broadside.styles": {
			"class": "MediaWiki\\ResourceLoader\\SkinModule",
			"features": {
				"accessibility": true,
				"normalize": true,
				"elements": true,
				"content-media": true,
				"content-links": true,
				"content-tables": true,
				"interface-core": true,
				"interface-edit-section-links": true,
				"interface-indicators": true,
				"interface-subtitle": true,
				"interface-user-message": true,
				"interface-site-notice": true,
				"i18n-ordered-lists": true,
				"i18n-headings": true
			},
			"styles": [
				"skins.broadside/tokens.css",
				"skins.broadside/frame.css",
				"skins.broadside/prose.css",
				"skins.broadside/parts.css"
			]
		},
		"skins.broadside": {
			"scripts": [
				"skins.broadside/broadside.js"
			],
			"messages": [
				"pickipediacontent-posts-card-missing",
				"pickipediacontent-posts-card-leaves",
				"pickipediacontent-posts-card-listen",
				"pickipediacontent-posts-dock-back",
				"pickipediacontent-posts-dock-close"
			],
			"dependencies": [
				"mediawiki.util"
			]
		}
	},
	"ResourceFileModulePaths": {
		"localBasePath": "resources",
		"remoteExtPath": "PickiPediaContent/resources"
	},
	"SpecialPages": {
		"EmergentBundles": "MediaWiki\\Extension\\PickiPediaContent\\SpecialEmergentBundles"
	},
	"ExtensionMessagesFiles": {
		"PickiPediaContentAlias": "PickiPediaContent.alias.php",
		"PickiPediaContentMagic": "PickiPediaContent.i18n.magic.php"
	},
	"DefaultUserOptions": {
		"pickipedia-pronouns": ""
	},
	"config": {
		"PickiPediaContentMagentaUrl": {
			"value": "https://memory-lane.maybelle.cryptograss.live",
			"description": "Where magenta is: Special:EmergentBundles reads the emergents' bundle records from its /api/bundles/, and each save, move and upload here is pushed to its /api/wiki/hook/ (MagentaPush.php)"
		},
		"PickiPediaContentMagentaHookSecret": {
			"value": "",
			"description": "Signs the push to magenta's /api/wiki/hook/ (HMAC-SHA256, X-Magenta-Signature); the same secret is magenta's WIKI_HOOK_SECRET. Empty: nothing is pushed, and magenta's minute sweep alone serves."
		},
		"PickiPediaContentMagentaPublicUrl": {
			"value": "https://magenta.cryptograss.live",
			"description": "magenta as a reader's browser reaches it: a page that is a tiding there asks its /api/wiki/tiding/, and links to it, in a banner atop the page (ext.pickipediaContent.tidingBanner)"
		},
		"PickiPediaContentPosts": {
			"value": true,
			"description": "Whether a user's subpages are posts, read in the Broadside skin (src/Posts/). False: they are ordinary wiki pages again, at once, with nothing else to undo."
		}
	},
	"manifest_version": 2,
	"ValidSkinNames": {
		"broadside": {
			"displayname": "Broadside",
			"class": "MediaWiki\\Extension\\PickiPediaContent\\Posts\\SkinBroadside",
			"skippable": true,
			"args": [
				{
					"name": "broadside",
					"responsive": true,
					"toc": false,
					"supportsMwHeading": true,
					"templateDirectory": "templates/broadside",
					"styles": [
						"skins.broadside.styles"
					],
					"scripts": [
						"skins.broadside"
					],
					"messages": [
						"pickipediacontent-posts-about",
						"pickipediacontent-posts-begin",
						"pickipediacontent-posts-beside",
						"pickipediacontent-posts-block",
						"pickipediacontent-posts-dock",
						"pickipediacontent-posts-home",
						"pickipediacontent-posts-listen",
						"pickipediacontent-posts-mode",
						"pickipediacontent-posts-more-tools",
						"pickipediacontent-posts-more-writing",
						"pickipediacontent-posts-on-magenta",
						"pickipediacontent-posts-plain",
						"pickipediacontent-posts-search",
						"pickipediacontent-posts-series",
						"pickipediacontent-posts-site",
						"pickipediacontent-posts-skip",
						"pickipediacontent-posts-songpage",
						"pickipediacontent-posts-songs-note",
						"pickipediacontent-posts-thread",
						"pickipediacontent-posts-thread-empty",
						"pickipediacontent-posts-thread-go",
						"pickipediacontent-posts-tiding",
						"pickipediacontent-posts-tiding-go",
						"pickipediacontent-posts-toc",
						"pickipediacontent-posts-tools",
						"pickipediacontent-posts-user-page",
						"pickipediacontent-posts-you"
					]
				}
			]
		}
	},
	"APIModules": {
		"pagecard": "MediaWiki\\Extension\\PickiPediaContent\\Posts\\ApiPageCard"
	}
}
